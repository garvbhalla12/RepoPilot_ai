# Copy to .env (PowerShell: Copy-Item .env.example .env). Never commit .env.
# Every setting is optional; the app runs with none of them (retrieval-only mode).

# ---- Storage -------------------------------------------------------------
# REPOPILOT_DATA_DIR=.repopilot_data

# ---- Embeddings (local) --------------------------------------------------
# sentence-transformers = neural embeddings, model downloads on first use.
# hashing = offline lexical fallback (no download, not truly semantic).
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Retrieval / chunking ------------------------------------------------
# TOP_K=5
# MIN_SCORE=0.05        # below this similarity the chat answers "insufficient evidence" (untuned default)
# CHUNK_MAX_LINES=60
# CHUNK_OVERLAP_LINES=10

# ---- Upload limits -------------------------------------------------------
# MAX_ZIP_MB=50
# MAX_FILES=5000
# MAX_EXTRACTED_MB=200
# MAX_FILE_KB=512

# ---- Optional LLM provider ----------------------------------------------
# Off by default. When true, retrieved snippets (secret-like values redacted) are sent to the provider below.
LLM_ENABLED=false
# openai = any OpenAI-compatible chat/completions API (OpenAI, Ollama, LM Studio, ...); anthropic = Anthropic Messages API
LLM_PROVIDER=openai
# Required when enabled. Use a model name from your provider's documentation.
LLM_MODEL=
# Optional override, e.g. a local Ollama server: http://localhost:11434/v1  (https required otherwise)
LLM_BASE_URL=
LLM_TIMEOUT_S=60
# Keys are read from the environment only. Not needed for localhost endpoints.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
